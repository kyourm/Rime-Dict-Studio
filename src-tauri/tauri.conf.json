{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rime Dict Studio",
  "version": "0.1.1",
  "identifier": "dev.rime.dictstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Rime Dict Studio", "width": 1180, "height": 760, "minWidth": 640, "minHeight": 620 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
