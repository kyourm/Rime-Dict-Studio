{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rime Dict Studio",
  "version": "0.2.0",
  "identifier": "dev.rime.dictstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Rime Dict Studio", "width": 720, "height": 560, "minWidth": 560, "minHeight": 480 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
